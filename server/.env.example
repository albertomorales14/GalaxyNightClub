# Copia este archivo como .env y rellena los valores. Nunca subas el .env al repositorio.

# Entorno: development | production
NODE_ENV=development
PORT=5050

# Cadena de conexión de MongoDB (local por defecto)
MONGODB_URI=mongodb://127.0.0.1:27017/galaxy_club

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres en producción).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Orígenes del cliente permitidos, separados por comas
CORS_ORIGINS=http://localhost:5173

# SameSite de la cookie de sesión: lax (cliente y API en el mismo sitio) o none (dominios distintos, requiere HTTPS)
# Por defecto: lax en desarrollo, none en producción
# COOKIE_SAMESITE=lax

# Número de proxies delante del servidor (1 en Render). Por defecto: 1 en producción, 0 en desarrollo
# TRUST_PROXY=1

# Cloudinary (imágenes de perfil)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
