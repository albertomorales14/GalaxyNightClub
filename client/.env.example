# Copia este archivo como .env.local si necesitas cambiar algo. Normalmente no hace falta.

# URL base de la API. Vacío (por defecto) = mismo origen: en desarrollo Vite redirige /api al
# servidor local y en Vercel lo hace el rewrite de vercel.json.
# VITE_API_URL=

# Servidor al que el proxy de desarrollo de Vite envía /api (por defecto http://localhost:5050)
# DEV_API_PROXY=http://localhost:5050
